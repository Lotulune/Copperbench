<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Properties>
        <Property name="logRoot">${sys:log_directory:-${sys:java.io.tmpdir}}</Property>
    </Properties>
    <Appenders>
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%style{%d{yyyy-MM-dd-HH:mm:ss}}{white} %highlight{[%t/%p]} %style{[%c]}{blue} %m%n"
                    disableAnsi="${sys:log_disable_ansi}"/>
        </Console>
        <RollingFile name="ROLLINGFILE" fileName="${logRoot}/logs/mcreator.log"
                     filePattern="${logRoot}/logs/mcreator_%d{yyyy_MM_dd}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd-HH:mm:ss} [%t/%p] [%c] %m%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="50MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <OnStartupTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="50">
                <Delete basePath="${logRoot}/logs" maxDepth="1">
                    <IfFileName glob="mcreator_*.log">
                        <IfAccumulatedFileCount exceeds="50"/>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="net.mcreator" level="ALL"/>
        <Root level="ALL">
            <AppenderRef ref="CONSOLE" level="ALL"/>
            <AppenderRef ref="ROLLINGFILE" level="ALL"/>
        </Root>
    </Loggers>
</Configuration>
