{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-core:0.1:handshake-result",
  "title": "UI-Core schema handshake result",
  "type": "object",
  "required": ["messageType", "requestId", "status", "selectedSchemaVersion", "coreSchemaVersions", "diagnostics"],
  "properties": {
    "messageType": { "const": "handshake_result" },
    "requestId": { "$ref": "urn:ui-core:0.1:common#/$defs/uuid" },
    "status": { "type": "string", "enum": ["compatible", "incompatible"] },
    "selectedSchemaVersion": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "coreSchemaVersions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "urn:ui-core:0.1:common#/$defs/diagnostic" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "compatible" } }, "required": ["status"] },
      "then": {
        "properties": {
          "selectedSchemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "diagnostics": { "type": "array", "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "selectedSchemaVersion": { "type": "null" },
          "diagnostics": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
