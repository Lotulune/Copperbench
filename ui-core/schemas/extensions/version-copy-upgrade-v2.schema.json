{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:copperbench:version-copy-upgrade:2",
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sourceValue": {},
        "disposition": {
          "enum": [
            "convertible",
            "manual",
            "unsupported"
          ]
        },
        "reasonCode": {
          "type": "string"
        },
        "targetMeaning": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sourceValue",
        "disposition",
        "reasonCode",
        "targetMeaning",
        "recovery",
        "evidence"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "ruleVersion": {
          "type": "string"
        },
        "sourceWorkspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 0
        },
        "sourceGeneratorId": {
          "enum": [
            "fabric-26.2",
            "neoforge-26.2"
          ]
        },
        "targetGeneratorId": {
          "enum": [
            "fabric-26.3",
            "neoforge-26.3"
          ]
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "copyOnly": {
          "const": true
        },
        "sourceUnchanged": {
          "const": true
        },
        "executionAvailable": {
          "type": "boolean"
        },
        "worldPolicy": {
          "const": "excluded_requires_separate_authorization"
        },
        "recovery": {
          "const": "continue_using_unchanged_source"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "convertible": {
              "type": "integer",
              "minimum": 0
            },
            "manual": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "convertible",
            "manual",
            "unsupported"
          ],
          "additionalProperties": false
        },
        "outputName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "targetDirectory": {
          "type": "string",
          "minLength": 1
        },
        "targetPluginFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ruleVersion",
        "sourceWorkspaceId",
        "sourceRevision",
        "sourceGeneratorId",
        "targetGeneratorId",
        "sourceFingerprint",
        "planId",
        "copyOnly",
        "sourceUnchanged",
        "executionAvailable",
        "worldPolicy",
        "recovery",
        "entries",
        "counts",
        "outputName",
        "targetDirectory",
        "targetPluginFingerprint"
      ],
      "additionalProperties": false
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "supportedVersions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "2"
              }
            },
            "operation": {
              "const": "negotiate"
            }
          },
          "required": [
            "supportedVersions",
            "operation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "supportedVersions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "2"
              }
            },
            "operation": {
              "const": "preview"
            },
            "targetGeneratorId": {
              "enum": [
                "fabric-26.3",
                "neoforge-26.3"
              ]
            },
            "outputName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "supportedVersions",
            "operation",
            "targetGeneratorId",
            "outputName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "supportedVersions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "2"
              }
            },
            "operation": {
              "const": "execute"
            },
            "targetGeneratorId": {
              "enum": [
                "fabric-26.3",
                "neoforge-26.3"
              ]
            },
            "outputName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "planId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "userApproved": {
              "type": "boolean"
            },
            "taskAuthorizationId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "supportedVersions",
            "operation",
            "targetGeneratorId",
            "outputName",
            "planId",
            "expectedRevision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "version_copy_upgrade"
        },
        "schemaVersion": {
          "const": "2"
        },
        "selectedVersion": {
          "const": "2"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "succeeded",
            "rejected",
            "failed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "executionAvailable": {
          "const": true
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "ruleVersion": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "schemaVersion",
        "requestId",
        "workspaceId",
        "status",
        "diagnostics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "selectedVersion"
            ],
            "oneOf": [
              {
                "required": [
                  "plan"
                ],
                "properties": {
                  "plan": {}
                },
                "type": "object"
              },
              {
                "required": [
                  "executionAvailable",
                  "ruleVersion"
                ],
                "properties": {
                  "executionAvailable": {},
                  "ruleVersion": {}
                },
                "type": "object"
              },
              {
                "required": [
                  "execution"
                ],
                "properties": {
                  "execution": {
                    "properties": {
                      "status": {
                        "const": "prepared"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            ],
            "properties": {
              "selectedVersion": {}
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "diagnostics": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "execution"
            ],
            "properties": {
              "execution": {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "type": "object"
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "plan"
                  ],
                  "properties": {
                    "plan": {}
                  },
                  "type": "object"
                },
                {
                  "required": [
                    "execution"
                  ],
                  "properties": {
                    "execution": {}
                  },
                  "type": "object"
                }
              ]
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ruleVersion": {
          "type": "string"
        },
        "targetDirectory": {
          "type": "string",
          "minLength": 1
        },
        "sourceWorkspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "prepared",
            "failed"
          ]
        },
        "conversionComplete": {
          "type": "boolean"
        },
        "acceptance": {
          "const": "not_run"
        },
        "worldsCopied": {
          "const": false
        },
        "sourceUnchanged": {
          "type": "boolean"
        },
        "targetWorkspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "targetWorkspaceFile": {
          "type": "string"
        },
        "targetGeneratorId": {
          "enum": [
            "fabric-26.3",
            "neoforge-26.3"
          ]
        },
        "targetRevision": {
          "const": 0
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "planId",
        "ruleVersion",
        "targetDirectory",
        "sourceWorkspaceId",
        "sourceFingerprint",
        "status",
        "conversionComplete",
        "acceptance",
        "worldsCopied"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "prepared"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "conversionComplete": {
                "const": true
              },
              "sourceUnchanged": {
                "const": true
              },
              "targetWorkspaceId": {},
              "targetWorkspaceFile": {},
              "targetGeneratorId": {},
              "targetRevision": {}
            },
            "required": [
              "targetWorkspaceId",
              "targetWorkspaceFile",
              "targetGeneratorId",
              "targetRevision",
              "sourceUnchanged"
            ],
            "type": "object"
          },
          "else": {
            "properties": {
              "conversionComplete": {
                "const": false
              }
            },
            "type": "object"
          }
        }
      ]
    }
  }
}
