{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-core:1.0:query-result",
  "title": "UI-Core query result v1.0",
  "type": "object",
  "required": [
    "messageType",
    "schemaVersion",
    "requestId",
    "workspaceId",
    "operation",
    "status",
    "revision",
    "data",
    "diagnostics"
  ],
  "properties": {
    "messageType": {
      "const": "query_result"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "$ref": "urn:ui-core:1.0:common#/$defs/uuid"
    },
    "workspaceId": {
      "$ref": "urn:ui-core:1.0:common#/$defs/uuid"
    },
    "operation": {
      "$ref": "urn:ui-core:1.0:query#/properties/operation"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "rejected",
        "failed"
      ]
    },
    "revision": {
      "$ref": "urn:ui-core:1.0:common#/$defs/revision"
    },
    "data": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:ui-core:1.0:common#/$defs/diagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "get_workspace_doctor"}, "status": {"const": "succeeded"}}, "required": ["operation", "status"]},
      "then": {"properties": {"data": {"$ref": "urn:ui-core:1.0:workspace-doctor"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "get_mod_element_field_contract"}, "status": {"const": "succeeded"}}, "required": ["operation", "status"]},
      "then": {"properties": {"data": {"$ref": "urn:ui-core:1.0:element-field-contract"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "get_field_reference_options"}, "status": {"const": "succeeded"}}, "required": ["operation", "status"]},
      "then": {"properties": {"data": {"type": "object", "required": ["elementType", "generatorId", "mappingSource", "scope", "total", "offset", "limit", "truncated", "options"],
        "properties": {
          "elementType": {"type": "string"}, "generatorId": {"type": "string"}, "mappingSource": {"type": "string"},
          "scope": {"const": "vanilla_generator_mappings"}, "total": {"type": "integer", "minimum": 0},
          "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 200},
          "truncated": {"type": "boolean"}, "options": {"type": "array", "maxItems": 200, "items": {
            "type": "object", "required": ["value", "label", "requiredApis"], "properties": {
              "value": {"type": "string"}, "label": {"type": "string"}, "requiredApis": {"type": "array", "items": {"type": "string"}}}}}
        }}}}
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "preview_generation"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "contractVersion",
              "scope",
              "revision",
              "generator",
              "status",
              "reasonCode",
              "inputFingerprint",
              "fingerprintScope",
              "managedPaths",
              "managedPathCount",
              "managedPathsTruncated",
              "conflicts",
              "conflictCount",
              "conflictsTruncated",
              "dependenciesRequired",
              "executionRechecksInputs",
              "nextSteps"
            ],
            "properties": {
              "contractVersion": {
                "const": "1"
              },
              "scope": {
                "const": "generation_source_safety"
              },
              "revision": {
                "$ref": "urn:ui-core:1.0:common#/$defs/revision"
              },
              "generator": {
                "type": "object"
              },
              "status": {
                "enum": [
                  "ready",
                  "conflicted",
                  "unknown"
                ]
              },
              "reasonCode": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "inputFingerprint": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "fingerprintScope": {
                "const": "workspace_inputs"
              },
              "managedPaths": {
                "type": "array",
              "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                }
              },
              "managedPathCount": {
                "type": "integer",
                "minimum": 0
              },
              "managedPathsTruncated": {
                "type": "boolean"
              },
              "conflicts": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "relativePath",
                    "reasonCode",
                    "expectedOwnership",
                    "observedOwnership"
                  ],
                  "properties": {
                    "relativePath": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]*$"
                    },
                    "reasonCode": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expectedOwnership": {
                      "const": "generated"
                    },
                    "observedOwnership": {
                      "enum": [
                        "unowned",
                        "manual",
                        "generated",
                        "unknown"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "conflictCount": {
                "type": "integer",
                "minimum": 0
              },
              "conflictsTruncated": {
                "type": "boolean"
              },
              "dependenciesRequired": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "executionRechecksInputs": {
                "const": true
              },
              "nextSteps": {
                "type": "array",
                "items": {
                  "enum": [
                    "inspect_source",
                    "keep_native_workflow",
                    "review_migration"
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "inputFingerprint": {
                      "type": "string"
                    },
                    "conflictCount": {
                      "const": 0
                    },
                    "conflicts": {
                    "type": "array",
                      "maxItems": 0
                    },
                    "reasonCode": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "conflicted"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "conflictCount": {
                    "type": "integer",
                      "minimum": 1
                    },
                    "conflicts": {
                    "type": "array",
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unknown"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "reasonCode": {
                      "type": "string"
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "list_workspace_files"}, "status": {"const": "succeeded"}}, "required": ["operation", "status"]},
      "then": {"properties": {"data": {
        "type": "object", "required": ["files", "total", "nextOffset", "truncated", "maxFileBytes"],
        "properties": {
          "files": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/workspaceSourceFile"}},
          "total": {"type": "integer", "minimum": 0}, "nextOffset": {"type": ["integer", "null"], "minimum": 0},
          "truncated": {"type": "boolean"}, "maxFileBytes": {"type": "integer", "minimum": 1}
        }, "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"operation": {"const": "read_workspace_file"}, "status": {"const": "succeeded"}}, "required": ["operation", "status"]},
      "then": {"properties": {"data": {
        "allOf": [{"$ref": "#/$defs/workspaceSourceFile"}, {
          "type": "object", "required": ["content", "sha256"],
          "properties": {"content": {"type": "string", "maxLength": 1048576}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
        }]
      }}}
    },
    {
      "if": {"properties": {"operation": {"const": "get_workspace_source_index"}, "status": {"const": "succeeded"}}, "required": ["operation", "status"]},
      "then": {"properties": {"data": {
        "type": "object", "required": ["entries", "scannedFiles", "truncated"],
        "properties": {
          "entries": {"type": "array", "maxItems": 300, "items": {
            "type": "object", "required": ["id", "kind", "relativePath", "line", "symbol", "evidence"],
            "properties": {
              "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["entrypoint", "registration", "resource_reference"]},
              "relativePath": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1},
              "symbol": {"type": "string"}, "evidence": {"type": "string"}, "resourceId": {"type": "string"}
            }, "additionalProperties": false
          }},
          "scannedFiles": {"type": "integer", "minimum": 0}, "skippedFiles": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}
        }, "additionalProperties": false
      }}}
    },
    {
      "if": { "properties": { "operation": { "const": "get_procedure_editor" }, "status": { "const": "succeeded" } }, "required": ["operation", "status"] },
      "then": { "properties": { "data": {
        "type": "object",
        "properties": { "triggerCatalog": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "label", "dependencies"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "$ref": "urn:ui-core:1.0:common#/$defs/localizedText" },
              "dependencies": { "type": "array", "items": {
                "type": "object", "required": ["name", "type"], "additionalProperties": false,
                "properties": { "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 } }
              } }
            }
          }
        } }
      } } }
    },
    {
      "if": { "properties": { "operation": { "const": "get_blockbench_task" }, "status": { "const": "succeeded" } }, "required": ["operation", "status"] },
      "then": { "properties": { "data": { "$ref": "urn:ui-core:1.0:asset#/$defs/modelingTask" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "list_blockbench_tasks" }, "status": { "const": "succeeded" } }, "required": ["operation", "status"] },
      "then": { "properties": { "data": {
        "type": "object", "required": ["tasks"],
        "properties": { "tasks": { "type": "array", "items": { "$ref": "urn:ui-core:1.0:asset#/$defs/modelingTask" } } },
        "additionalProperties": false
      } } }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list_new_workspace_generators"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/newWorkspaceGeneratorCatalog"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "preview_recovery_restore"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/recoveryRestorePreview"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "get_workbench"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/workbenchProjection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list_mod_elements"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/modElementListProjection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list_assets"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:asset"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "get_mod_element_editor"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/modElementEditorProjection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "get_task"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/taskProjection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "get_diff"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/historyComparison"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list_operation_approvals"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:ui-core:1.0:common#/$defs/operationApprovalListProjection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list_task_authorizations"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "schemaVersion",
              "authorizations"
            ],
            "properties": {
              "schemaVersion": {
                "const": "1.0"
              },
              "authorizations": {
                "type": "array",
                "items": {
                  "$ref": "urn:ui-core:1.0:common#/$defs/taskAuthorization"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "workspaceSourceFile": {
      "type": "object", "required": ["relativePath", "name", "language", "size", "ownership", "editable", "reasonCode"],
      "properties": {
        "relativePath": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "language": {"type": "string"},
        "size": {"type": "integer", "minimum": 0}, "ownership": {"enum": ["manual", "generated"]},
        "editable": {"type": "boolean"}, "reasonCode": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": false
}
