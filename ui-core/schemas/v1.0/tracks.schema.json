{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-core:1.0:tracks",
  "title": "UI-Core version track matrix v1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "latestMinecraftVersion",
    "previousMinecraftVersion",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "latestMinecraftVersion": {
      "type": "string",
      "minLength": 1
    },
    "previousMinecraftVersion": {
      "type": "string",
      "minLength": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "minecraftVersion",
          "displayName",
          "dynamic",
          "loaders"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "latest_stable",
              "previous_stable",
              "minecraft_1_21_1",
              "minecraft_1_20_1"
            ]
          },
          "minecraftVersion": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "dynamic": {
            "type": "boolean"
          },
          "loaders": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "loader",
                "generatorId",
                "minecraftVersion",
                "status",
                "reasonCode",
                "notes"
              ],
              "properties": {
                "loader": {
                  "type": "string",
                  "enum": [
                    "fabric",
                    "neoforge"
                  ]
                },
                "generatorId": {
                  "type": "string"
                },
                "minecraftVersion": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "preview",
                    "unavailable",
                    "coincides"
                  ]
                },
                "pluginId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reasonCode": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "currentWorkspace": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
