{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-core:1.0:workspace-doctor",
  "title": "Read-only workspace doctor v1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "scope",
    "readOnly",
    "networkProbed",
    "generatorId",
    "workspaceRoot",
    "processWorkingDirectory",
    "application",
    "capabilities",
    "execution",
    "findings",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "scope": {
      "const": "local_observation"
    },
    "readOnly": {
      "const": true
    },
    "networkProbed": {
      "const": false
    },
    "generatorId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspaceRoot": {
      "type": [
        "string",
        "null"
      ]
    },
    "processWorkingDirectory": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "blocked",
        "unknown"
      ]
    },
    "application": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "coreSchemaVersion",
        "doctorSchemaVersion",
        "queries",
        "implicitNetworkProbe",
        "implicitTaskAuthorization"
      ],
      "properties": {
        "coreSchemaVersion": {
          "const": "1.0"
        },
        "doctorSchemaVersion": {
          "const": "1.0"
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implicitNetworkProbe": {
          "const": false
        },
        "implicitTaskAuthorization": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "code",
          "message",
          "nextStep",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "available",
              "missing",
              "unsupported",
              "blocked",
              "unknown"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "nextStep": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
