  "featureCoverage": [
    {
      "id": "workspace_lifecycle",
      "area": "T01",
      "surface": "new_ui",
      "notes": "Create, open, and import upstream workspaces through the shared application service."
    },
    {
      "id": "local_history",
      "area": "T02",
      "surface": "new_ui",
      "notes": "Local recovery points and restore. Existing Git remotes are not rewritten."
    },
    {
      "id": "slice_elements",
      "area": "T03",
      "surface": "new_ui",
      "notes": "Stage 11 first-party editing covers all 37 Java mod element types through the shared UI, MCP, headless, persistence, diagnostics, and recovery services."
    },
    {
      "id": "other_mod_elements",
      "area": "T03",
      "surface": "new_ui",
      "notes": "The 30 Stage 11 Java types use upstream storage models and the schema-driven editor. Bedrock add-on types remain outside this product scope."
    },
    {
      "id": "assets_blockbench",
      "area": "T04",
      "surface": "new_ui",
      "notes": "Asset graph and Blockbench round trip exist. Fabric 1.21.1 runClient loaded file/copper_ready_pack.zip in ResourceManager."
    },
    {
      "id": "mcp_automation",
      "area": "T05",
      "surface": "headless_mcp",
      "notes": "First-party local MCP with read_only, workspace, and full_access profiles."
    },
    {
      "id": "generate_source",
      "area": "T06",
      "surface": "new_ui",
      "notes": "The shared generator path accepts all Stage 11 Java element types; core block/item/recipe/procedure and data-element golden evidence remain tracked per generator."
    },
    {
      "id": "managed_build",
      "area": "T07",
      "surface": "new_ui",
      "notes": "Managed build, server, datagen, and GameTest tasks exist. Datagen publishes only after staged diff confirmation. All-track Stage 9 server readiness remains pending."
    },
    {
      "id": "run_client",
      "area": "T08",
      "surface": "new_ui",
      "notes": "runClient evidence exists for Fabric/NeoForge 26.2, 26.1.2, 1.21.1, and 1.20.1."
    },
    {
      "id": "diagnostics",
      "area": "T09",
      "surface": "new_ui",
      "notes": "Structured diagnostics and reason codes are shared by UI, MCP, and headless."
    },
    {
      "id": "loader_migration",
      "area": "T10",
      "surface": "new_ui",
      "notes": "Copy-only same-version Fabric↔NeoForge migration. Source trees stay unchanged."
    },
    {
      "id": "resource_pack_export",
      "area": "T10",
      "surface": "new_ui",
      "notes": "Publish batches export ZIP and prepare run/resourcepacks without auto-launching. Fabric 1.21.1 ResourceManager listed file/copper_ready_pack.zip."
    },
    {
      "id": "window_chrome_jcef",
      "area": "U4",
      "surface": "new_ui",
      "notes": "Playwright help/About/DPI/hit-test is 100/100. Real JCEF product-shell reported React chrome regions, native HTMAXBUTTON=9 Snap hit-test, and WM_DPICHANGED 144 (DPR 1.5)."
    },
    {
      "id": "java_plugins",
      "area": "plugins",
      "surface": "legacy_window",
      "notes": "Java plugins are opt-in full trust. Swing UI plugins stay in a legacy window. list_installed_plugins returns the live first-party and user plugin inventory without loading Java."
    },
    {
      "id": "remote_mcp",
      "area": "excluded",
      "surface": "not_applicable",
      "notes": "Remote MCP is out of first-release scope."
    },
    {
      "id": "linux_macos",
      "area": "excluded",
      "surface": "not_applicable",
      "notes": "Linux and macOS installers are out of first-release scope."
    },
    {
      "id": "windows_10",
      "area": "excluded",
      "surface": "not_applicable",
      "notes": "Windows 10 is out of first-release scope. The supported desktop is Windows 11 x64."
    },
    {
      "id": "accounts_cloud",
      "area": "excluded",
      "surface": "not_applicable",
      "notes": "Accounts, cloud sync, and vendor chat are out of first-release scope."
    },
    {
      "id": "code_signing",
      "area": "release",
      "surface": "not_applicable",
      "notes": "Unsigned GitHub Releases are the first public distribution. Authenticode is optional and not a release gate. jsign 7.4 stays wired."
    },
    {
      "id": "clean_machine_install",
      "area": "release",
      "surface": "new_ui",
      "notes": "Windows 11 Hyper-V guest silent install/upgrade/uninstall preserved workspace and .copperbench. With the NIC disconnected, copperbench.exe remained running through the 10-second guest check."
    }
  ],
