  "upstreamTools": {
    "schemaVersion": "1.0",
    "notes": "此表说明 MCreator 工具在 Copperbench 中的入口和支持范围。旧版窗口的布局与无障碍支持可能与新工作台不同。",
    "tools": [
      {"id": "workspace_open_create_import", "upstream": "打开、新建、导入工作区（File / Workspace）", "surface": "new_ui", "notes": "导入时创建同级目录副本，并保留未知字段。"},
      {"id": "mod_elements_first_party", "upstream": "模组元素（Mod Elements）：37 种 Java 元素类型", "surface": "new_ui", "notes": "所有 Java 元素类型均可通过通用编辑器管理；可生成的功能取决于加载器和版本。"},
      {"id": "mod_elements_other", "upstream": "生物实体、界面、植物、维度等元素编辑器", "surface": "new_ui", "notes": "这些 Java 元素类型已纳入内置支持；基岩版专属元素不在此范围内。"},
      {"id": "assets_blockbench", "upstream": "模型与动画（Blockbench）", "surface": "new_ui", "notes": "从资产视图打开独立的 Blockbench 编辑器，并跟踪资源引用。"},
      {"id": "resource_pack_workspace", "upstream": "资源包制作与 ZIP 导出（Resource Pack）", "surface": "new_ui", "notes": "支持可复现 ZIP 导出、发布批次和客户端准备；已有 Fabric 1.21.1 资源管理器加载验证记录。"},
      {"id": "textures_sounds_structures", "upstream": "纹理、声音、结构与截图（Resources）", "surface": "legacy_window", "notes": "纹理、声音和结构浏览器仍在旧版 Swing 窗口中；模型编辑使用 Blockbench。"},
      {"id": "image_armor_animation_makers", "upstream": "图像编辑器、盔甲纹理与动态纹理（Tools）", "surface": "legacy_window", "notes": "这些制作工具仍在旧版 Swing 窗口中。"},
      {"id": "tags_variables_localization", "upstream": "标签、变量与本地化（Tags / Variables / Localization）", "surface": "new_ui", "notes": "在“变量与数据”中管理条目、预览重命名影响、导入导出 CSV/JSON，并查看缺失或重复翻译。"},
      {"id": "code_ide_and_file_browser", "upstream": "代码编辑器与工作区文件浏览器（Code Editor）", "surface": "legacy_window", "notes": "手写源码通过旧版编辑器维护；新工作台暂不提供完整代码开发环境。"},
