{
  "schemaVersion": "1.0",
  "product": {
    "name": "Copperbench",
    "version": "0.1.0",
    "id": "dev.copperbench.studio",
    "publisher": "Copperbench Contributors",
    "license": "GPL-3.0-only",
    "upstreamCore": "MCreator"
  },
  "platform": {
    "os": "windows",
    "arch": "x64",
    "minimumOs": "Windows 11",
    "offlineFirst": true
  },
  "privacy": {
    "accountsRequired": false,
    "defaultTelemetry": false,
    "implicitNetworkServices": false,
    "cdnFrontend": false
  },
  "packaging": {
    "executable": "copperbench.exe",
    "bundledJdk": {
      "installed": "jdk",
      "installedJava21": "jdk21",
      "sourceTreeJava25": "jdk/jbr25_win_64",
      "sourceTreeJava21": "jdk/jdk21_win_64"
    },
    "jcefBundledWithJdk": true,
    "pluginsDirectory": "plugins",
    "licenseDirectory": "license",
    "requiredEntries": [
      "copperbench.exe",
      "LICENSE.txt",
      "LICENSE-ADDITIONAL-TERMS.md",
      "jdk/bin/java.exe",
      "jdk/bin/jcef.dll",
      "jdk21/bin/java.exe",
      "jdk21/bin/javac.exe",
      "lib/copperbench.jar",
      "plugins",
      "gradlew",
      "gradlew.bat",
      "gradle/wrapper/gradle-wrapper.jar"
    ]
  },
  "bundledPlugins": [
    {
      "pluginId": "core",
      "packageName": "mcreator-core",
      "level": "A",
      "route": "RESOURCE_PIPELINE",
      "firstParty": true
